# Copy to .env (git-ignored) for local runs. On Render, set these in the Environment tab.

# Presenter access: open pages with ?presenter=<this value>.
# Leave empty locally and the default key "nightshift-dev" is used (the server prints the full link).
# On Render the default never applies: there PRESENTER_KEY must be set in the Environment tab.
PRESENTER_KEY=

# How the five screens stand in the room, left to right. Default: 2,1,3,4,5 (desk on the far left).
ROOM_ORDER=2,1,3,4,5

# Optional. The morning report is written by Claude (claude-haiku-5-5) with this key. Without it, or if
# the API fails or takes over 8 s, the built-in template writes it from the same event log.
# The key stays on the server: it is never sent to the browser.
ANTHROPIC_API_KEY=
