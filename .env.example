# Copy to .env (git-ignored) for local runs. On Render, set these in the Environment tab.

# Presenter access: open pages with ?presenter=<this value>.
# Leave empty and the server makes a one-off random key and prints the full link on startup.
PRESENTER_KEY=

# Phase 6, optional. Without it the Morning report uses the built-in template.
ANTHROPIC_API_KEY=
